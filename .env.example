# Keys belong on the backend only. Default mode works without external APIs.
AI_PROVIDER=rules
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
NVIDIA_API_KEY=
# Set true only for synthetic data or after organizer permission for cloud processing.
AI_DATA_POLICY_APPROVED=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
AI_TIMEOUT_SECONDS=7
AI_REQUESTS_PER_MINUTE=6
AI_REQUESTS_PER_DAY=300
# Synthetic, local demo only. Disable before any public deployment.
DEMO_MODE=true
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=sqlite:///./data/career-quest.db
