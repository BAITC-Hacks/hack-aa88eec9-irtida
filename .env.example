# Keys belong on the backend only. Default mode works without external APIs.
AI_PROVIDER=rules
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
NVIDIA_API_KEY=
# Set true only for synthetic data or after organizer permission for cloud processing.
AI_DATA_POLICY_APPROVED=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
# Local personalization check without an API key or network request.
NVIDIA_AI_MOCK=false
# Keep the explicit planning request within the hackathon's 10-second AI budget.
NVIDIA_TIMEOUT_SECONDS=8
NVIDIA_MAX_TOKENS=1800
AI_TIMEOUT_SECONDS=7
AI_REQUESTS_PER_MINUTE=6
AI_REQUESTS_PER_DAY=300
# Password login is the default. Legacy account picker is test-only.
DEMO_MODE=false
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173
# Optional: omit to use the local Kit database selected by start.bat.
# DATABASE_URL=sqlite:///./data/career-quest-kit.db
# Optional absolute directory containing the four original Kit files.
# CAREER_QUEST_KIT_DIR=C:/path/to/career_quest_dataset
